# Blue3 Drive — parâmetros/segredos do compose.
# Copie para build/.env e preencha. NÃO comite o .env real (ver build/.gitignore).

# ── Banco (db) ──
MYSQL_DATABASE=blue3drive
MYSQL_USER=blue3
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# ── Admin inicial do Nextcloud (criado no 1º boot) ──
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=troque-esta-senha-admin

# ── Acesso ──
# Domínios confiáveis (separados por espaço). 'app' = nome do serviço na rede do compose.
NEXTCLOUD_TRUSTED_DOMAINS=localhost app
# Porta HTTP exposta no host (http://localhost:8080)
APP_PORT=8080

# ── Whiteboard (servidor websocket) ──
WHITEBOARD_PORT=3002
# Segredo compartilhado NC <-> whiteboard (gere um aleatório, ex.: openssl rand -hex 32)
WHITEBOARD_JWT_SECRET=troque-este-segredo-jwt
# URL pública que o NAVEGADOR usa p/ alcançar o whiteboard
WHITEBOARD_PUBLIC_URL=http://localhost:3002
# URL interna que o WHITEBOARD usa p/ falar com o NC (rede do compose)
WHITEBOARD_NEXTCLOUD_URL=http://app

# ─────────────────────────────────────────────────────────────────────
# PRODUÇÃO (VPS) — só preencher ao usar build/compose.prod.yml (Caddy + HTTPS).
# Em dev/local, deixe comentado (a stack base ignora). Ver docs/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────
# Inclui o overlay de produção automaticamente no deploy.sh:
#DEPLOY_COMPOSE_OVERLAY=build/compose.prod.yml
# Hosts públicos (crie os registros DNS A → IP do VPS). Só o host, sem https://.
#NEXTCLOUD_PUBLIC_HOST=drive.blue3.com.br
#COLLABORA_PUBLIC_HOST=office.blue3.com.br
#WHITEBOARD_PUBLIC_HOST=whiteboard.blue3.com.br
# E-mail p/ o Let's Encrypt (Caddy gera/renova os certificados).
#ACME_EMAIL=admin@blue3.com.br
# Rede confiável do proxy reverso (Caddy). O padrão cobre a faixa Docker.
#NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
# Imagem do Collabora — PINAR uma versão estável (não usar latest em produção).
#COLLABORA_IMAGE=collabora/code:latest
